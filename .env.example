# Where to store generated artifacts (embeddings, labels, faces, index).
# Defaults to <project_root>/data if unset. Put it on an external drive
# alongside your photo library to keep the album fully portable.
# METADATA_DIR=/Volumes/MyDrive/photos/metadata

# OpenAI-compatible Vision API (used by src/Vision_Labeler.py and CJK→EN
# translation in src/Photo_Search.py). Any provider exposing the
# /v1/chat/completions endpoint with image inputs will work.
VISION_API_KEY=sk-your-key-here
VISION_BASE_URL=https://api.openai.com/v1
VISION_MODEL=gpt-4o-mini

# Pipeline tuning (optional — defaults shown)
SAMPLE_RATIO=0.5     # Smart_Sampler random sampling ratio (0~1)
CONCURRENCY=5        # Vision_Labeler parallel workers
BATCH_SIZE=4         # Local_Indexer CLIP batch size
NUM_WORKERS=2        # Local_Indexer DataLoader workers
